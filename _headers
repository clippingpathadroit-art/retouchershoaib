# Cloudflare Pages Caching Rules
# Main website marketing pages & assets load blazing-fast from cache
# ONLY Client Portal & Admin Panel are set to instant real-time revalidation

# Global security headers for all routes
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cache-Control: public, max-age=3600

# High-speed long-term caching for static media assets (images, fonts, videos)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ONLY Client Dashboard & Admin Panel: always fresh real-time data
/portal
  Cache-Control: no-cache, no-store, must-revalidate

/portal.html
  Cache-Control: no-cache, no-store, must-revalidate

/admin
  Cache-Control: no-cache, no-store, must-revalidate

/admin.html
  Cache-Control: no-cache, no-store, must-revalidate
