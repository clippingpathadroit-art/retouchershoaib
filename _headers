# Cloudflare Pages Caching Rules
# Marketing assets load blazing-fast; Portal & Admin Panel always fetch fresh real-time code

# Global security headers for all routes
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# High-speed long-term caching for static media assets (images, fonts, videos)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Dynamic HTML endpoints: always fresh real-time data, zero stale CDN caching
/portal
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0

/portal.html
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0

/admin
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0

/admin.html
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0

