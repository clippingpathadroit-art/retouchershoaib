# Cloudflare Pages Caching Rules
# Marketing assets load blazing-fast; Portal & Admin Panel always fetch fresh real-time code

# Global security headers for all routes
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# High-speed long-term caching for static media assets (images, fonts, videos)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Dynamic / private HTML endpoints: fresh real-time data, blocked from search indexing
/portal
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  X-Robots-Tag: noindex, nofollow

/portal.html
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  X-Robots-Tag: noindex, nofollow

/admin
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  X-Robots-Tag: noindex, nofollow

/admin.html
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  X-Robots-Tag: noindex, nofollow

/404
  X-Robots-Tag: noindex, nofollow

/404.html
  X-Robots-Tag: noindex, nofollow

